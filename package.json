{
  "name": "secure-grant-management-portal",
  "version": "1.0.0",
  "description": "Secure, multi-user web application for managing grant applications with RBAC and OAuth 2.0",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "test": "jest --runInBand --forceExit",
    "test:coverage": "jest --coverage --runInBand --forceExit"
  },
  "keywords": [
    "rbac",
    "oauth2",
    "grant-management",
    "express",
    "postgresql",
    "redis"
  ],
  "author": "Google DeepMind Agent",
  "license": "ISC",
  "dependencies": {
    "axios": "^1.7.9",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "ioredis": "^5.4.2",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "supertest": "^7.0.0"
  },
  "jest": {
    "testEnvironment": "node",
    "testTimeout": 15000,
    "coverageDirectory": "coverage",
    "collectCoverageFrom": [
      "src/**/*.js",
      "!src/server.js",
      "!src/config/db.js",
      "!src/config/seed.js"
    ],
    "coverageThreshold": {
      "global": {
        "statements": 70,
        "branches": 55,
        "functions": 70,
        "lines": 70
      }
    }
  }
}
